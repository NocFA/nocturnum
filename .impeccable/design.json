  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one primary action in a page head, such as Create snapshot.",
      "html": "<button class=\"ds-btn ds-btn-primary\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M2 4.5h10v7H2z\"/><path d=\"M4.5 4.5l1-2h3l1 2\"/><circle cx=\"7\" cy=\"8\" r=\"1.6\"/></svg>Create snapshot</button>",
      "css": ".ds-btn{height:30px;padding:0 12px;border-radius:var(--r,6px);display:inline-flex;align-items:center;gap:7px;background:var(--raised,#141821);border:1px solid var(--line-2,#262c39);color:var(--text,#e5e7eb);font:500 13px/1 var(--sans,'Geist Variable',system-ui,sans-serif);cursor:pointer;transition:background-color 120ms,border-color 120ms,color 120ms}.ds-btn-primary{background:var(--accent,#dc244c);border-color:var(--accent,#dc244c);color:#fff}.ds-btn-primary svg{color:rgba(255,255,255,.85)}.ds-btn-primary:hover{background:var(--accent-hover,#e83a60);border-color:var(--accent-hover,#e83a60)}.ds-btn:focus-visible{outline:2px solid var(--accent,#dc244c);outline-offset:2px}"
    },
    {
      "name": "Default Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Secondary actions such as Re-run, on the raised fill with a hairline border.",
      "html": "<button class=\"ds-btn-default\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 2.8v8.4L11 7z\"/></svg>Re-run</button>",
      "css": ".ds-btn-default{height:30px;padding:0 12px;border-radius:var(--r,6px);display:inline-flex;align-items:center;gap:7px;background:var(--raised,#141821);border:1px solid var(--line-2,#262c39);color:var(--text,#e5e7eb);font:500 13px/1 var(--sans,'Geist Variable',system-ui,sans-serif);cursor:pointer;transition:background-color 120ms,border-color 120ms}.ds-btn-default svg{color:var(--text-3,#7a8191)}.ds-btn-default:hover{background:#1a1f2a;border-color:var(--line-3,#323a4b)}.ds-btn-default:focus-visible{outline:2px solid var(--accent,#dc244c);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Low-weight actions such as Cancel in a dialog.",
      "html": "<button class=\"ds-btn-ghost\">Cancel</button>",
      "css": ".ds-btn-ghost{height:30px;padding:0 12px;border-radius:var(--r,6px);background:none;border:1px solid transparent;color:var(--text-2,#a3a9b5);font:500 13px/1 var(--sans,'Geist Variable',system-ui,sans-serif);cursor:pointer;transition:background-color 120ms,color 120ms}.ds-btn-ghost:hover{background:var(--hover,#171c26);color:var(--text,#e5e7eb)}.ds-btn-ghost:focus-visible{outline:2px solid var(--accent,#dc244c);outline-offset:2px}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "A 30px ground well with a crimson-edge focus halo.",
      "html": "<input class=\"ds-input\" placeholder=\"Search collections, ids, field:value\">",
      "css": ".ds-input{width:280px;height:30px;padding:0 10px;background:var(--ground,#0b0d12);border:1px solid var(--line-2,#262c39);border-radius:var(--r,6px);color:var(--text,#e5e7eb);caret-color:var(--accent-ink,#ff6b8a);font:400 13px var(--sans,'Geist Variable',system-ui,sans-serif);transition:border-color 120ms,box-shadow 120ms}.ds-input::placeholder{color:var(--text-3,#7a8191)}.ds-input:hover{border-color:var(--line-3,#323a4b)}.ds-input:focus-visible{outline:none;border-color:var(--accent-line,rgba(220,36,76,.45));box-shadow:0 0 0 3px var(--accent-soft,rgba(220,36,76,.12))}"
    },
    {
      "name": "Status Pills and Flag",
      "kind": "chip",
      "refersTo": "pill-ok",
      "description": "Engine signals: a rounded pill for status and a squarer flag for inline attention.",
      "html": "<span class=\"ds-pill ds-ok\"><i></i>ok</span> <span class=\"ds-pill ds-warn\"><i></i>optimizing</span> <span class=\"ds-pill ds-bad\"><i></i>failed</span> <span class=\"ds-flag\">over vacuum threshold</span>",
      "css": ".ds-pill{display:inline-flex;align-items:center;gap:6px;height:20px;padding:0 8px;border-radius:10px;font:500 12px var(--sans,'Geist Variable',system-ui,sans-serif)}.ds-pill i{width:5px;height:5px;border-radius:50%;background:currentColor}.ds-ok{color:var(--ok,#3fb37f);background:var(--ok-soft,rgba(63,179,127,.12))}.ds-warn{color:var(--warn,#e2a33b);background:var(--warn-soft,rgba(226,163,59,.11))}.ds-bad{color:var(--bad,#f0616d);background:var(--bad-soft,rgba(240,97,109,.12))}.ds-flag{display:inline-flex;align-items:center;min-height:20px;padding:0 7px;border-radius:4px;font:400 12px var(--sans,'Geist Variable',system-ui,sans-serif);color:var(--warn,#e2a33b);background:var(--warn-soft,rgba(226,163,59,.11))}"
    },
    {
      "name": "Segmented Control",
      "kind": "custom",
      "refersTo": "segmented",
      "description": "Small view switch, such as Payload and Vector on the point pane.",
      "html": "<div class=\"ds-seg\"><button aria-pressed=\"true\">Payload</button><button aria-pressed=\"false\">Vector</button></div>",
      "css": ".ds-seg{display:inline-flex;border:1px solid var(--line-2,#262c39);border-radius:4px;padding:1px;background:var(--ground,#0b0d12)}.ds-seg button{height:20px;padding:0 8px;border:0;border-radius:3px;background:none;color:var(--text-3,#7a8191);font:400 12px var(--sans,'Geist Variable',system-ui,sans-serif);cursor:pointer}.ds-seg button:hover{color:var(--text,#e5e7eb)}.ds-seg button[aria-pressed=true]{background:var(--raised,#141821);color:var(--text,#e5e7eb)}.ds-seg button:focus-visible{outline:2px solid var(--accent,#dc244c);outline-offset:2px}"
    },
    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "nav-item-current",
      "description": "Collection rows with a status dot and count, the current row marked by a 2px crimson edge.",
      "html": "<ul class=\"ds-nav\"><li><a href=\"#\"><span><i></i>bookmarks</span><b>2.9k</b></a></li><li><a href=\"#\" aria-current=\"page\"><span><i></i>notes</span><b>25.5k</b></a></li><li><a href=\"#\"><span><i></i>faces</span><b>1.2k</b></a></li></ul>",
      "css": ".ds-nav{list-style:none;margin:0;padding:8px;width:216px;background:var(--surface,#0f1218);font:400 13px var(--sans,'Geist Variable',system-ui,sans-serif)}.ds-nav a{position:relative;display:flex;justify-content:space-between;align-items:center;height:30px;padding:0 8px 0 10px;border-radius:4px;color:var(--text-2,#a3a9b5);text-decoration:none}.ds-nav span{display:flex;align-items:center;gap:8px}.ds-nav i{width:6px;height:6px;border-radius:50%;background:var(--ok,#3fb37f)}.ds-nav b{font-weight:400;font-size:12px;color:var(--text-3,#7a8191);font-variant-numeric:tabular-nums}.ds-nav a:hover{background:var(--hover,#171c26);color:var(--text,#e5e7eb)}.ds-nav a[aria-current=page]{background:var(--raised,#141821);color:var(--text,#e5e7eb)}.ds-nav a[aria-current=page]::before{content:'';position:absolute;left:-8px;top:7px;bottom:7px;width:2px;background:var(--accent,#dc244c);border-radius:0 2px 2px 0}.ds-nav a:focus-visible{outline:2px solid var(--accent,#dc244c);outline-offset:2px}"
    },
    {
      "name": "Panel with Table",
      "kind": "card",
      "refersTo": "panel",
      "description": "The hairline panel anatomy: 42px header with title and aside, then a dense table.",
      "html": "<section class=\"ds-panel\"><header><h2>Segments</h2><span>1</span></header><table><thead><tr><th>Segment</th><th class=\"r\">Points</th><th>State</th></tr></thead><tbody><tr><td class=\"m\">seg 1</td><td class=\"r\">21,575</td><td><span class=\"ok\"></span>Ready</td></tr><tr><td class=\"m\">memtable</td><td class=\"r\">4,425</td><td>20% to flush</td></tr></tbody></table></section>",
      "css": ".ds-panel{width:420px;background:var(--surface,#0f1218);border:1px solid var(--line,#1c212c);border-radius:8px;color:var(--text,#e5e7eb);font:400 13px/1.45 var(--sans,'Geist Variable',system-ui,sans-serif)}.ds-panel header{min-height:42px;display:flex;align-items:center;gap:10px;padding:0 14px 0 16px;border-bottom:1px solid var(--line,#1c212c)}.ds-panel h2{margin:0;font-size:13px;font-weight:600;letter-spacing:-.005em}.ds-panel header span{color:var(--text-3,#7a8191)}.ds-panel table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}.ds-panel th{height:32px;padding:0 12px;text-align:left;font-weight:500;font-size:12px;color:var(--text-3,#7a8191);border-bottom:1px solid var(--line,#1c212c)}.ds-panel td{height:40px;padding:0 12px;border-bottom:1px solid var(--line,#1c212c)}.ds-panel tr:last-child td{border-bottom:0}.ds-panel th:first-child,.ds-panel td:first-child{padding-left:16px}.ds-panel .r{text-align:right}.ds-panel .m{font-family:var(--mono,'Geist Mono Variable',ui-monospace,monospace);font-size:12px}.ds-panel .ok{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--ok,#3fb37f);margin-right:7px}.ds-panel tbody tr:hover td{background:var(--hover,#171c26)}"
    },
    {
      "name": "Points Table with JSON Pane",
      "kind": "custom",
      "refersTo": "points-row-selected",
      "description": "Signature: 28px point rows with a crimson selection marker, synced to a syntax-coloured JSON pane.",
      "html": "<div class=\"ds-pts\"><table><tbody><tr><td class=\"id\">40001</td><td>Mmap commit index</td></tr><tr aria-selected=\"true\"><td class=\"id\">40002</td><td>Fsync merge snapshot</td></tr><tr><td class=\"id\">40005</td><td>Tombstone recall payload</td></tr></tbody></table><pre class=\"ds-json\"><span class=\"p\">{</span>\n  <span class=\"k\">\"title\"</span><span class=\"p\">:</span> <span class=\"s\">\"Fsync merge snapshot\"</span><span class=\"p\">,</span>\n  <span class=\"k\">\"pinned\"</span><span class=\"p\">:</span> <span class=\"b\">false</span><span class=\"p\">,</span>\n  <span class=\"k\">\"rank\"</span><span class=\"p\">:</span> <span class=\"n\">0.982</span>\n<span class=\"p\">}</span></pre></div>",
      "css": ".ds-pts{width:420px;background:var(--surface,#0f1218);border:1px solid var(--line,#1c212c);border-radius:8px;overflow:hidden;font:400 13px var(--sans,'Geist Variable',system-ui,sans-serif);color:var(--text,#e5e7eb)}.ds-pts table{width:100%;border-collapse:collapse}.ds-pts td{height:28px;padding:0 12px;border-bottom:1px solid var(--line,#1c212c)}.ds-pts td:first-child{padding-left:16px}.ds-pts .id{width:72px;font-family:var(--mono,'Geist Mono Variable',ui-monospace,monospace);font-size:12px;color:var(--text-2,#a3a9b5);font-variant-numeric:tabular-nums}.ds-pts tr:hover td{background:var(--hover,#171c26)}.ds-pts tr[aria-selected=true] td{background:var(--accent-soft,rgba(220,36,76,.12))}.ds-pts tr[aria-selected=true] td:first-child{box-shadow:inset 2px 0 0 var(--accent,#dc244c);color:var(--text,#e5e7eb)}.ds-json{margin:0;padding:9px 16px;font:400 12.5px/20px var(--mono,'Geist Mono Variable',ui-monospace,monospace);color:var(--text-2,#a3a9b5)}.ds-json .k{color:#9cb4e0}.ds-json .s{color:#a6d18f}.ds-json .n{color:#e0b47a}.ds-json .b{color:#e58aa6}.ds-json .p{color:#5d6577}"
    }
  ],
  "narrative": {
    "northStar": "The Quiet Instrument Panel",
    "overview": "The console is the category standard played straight, a dark admin frame in the familiar shape of vector database dashboards with a sidebar of collections, a top bar with search and node health, and a main column of hairline panels, and it earns its place through finish and density. Everything is tuned so the operator can read engine state at a glance: tones step up from a near-black ground in small lifts, numbers sit in tabular columns, and the only saturated colours on screen are a single crimson for the thing you chose or the thing you should press, and the three engine signals for healthy, attention and failure.\n\nDensity is high and deliberate, with 13px body type, 28px point rows and a full collection overview that fits 1440 by 900 without scrolling. Machine values (ids, field keys, dimensions, versions, segment names, JSON) are set in Geist Mono, and human labels stay in Geist, so the two kinds of text never blur. There are no gradients, no glass and no glow anywhere, depth comes from hairline borders on lifted tones, and the only shadows belong to things that float above the frame.",
    "keyCharacteristics": [
      "Near-black ground with panels lifted one small step, separated by 1px hairlines.",
      "One crimson accent, spent on the primary action and on selection or current state.",
      "Green, amber and red reserved for engine health, always paired with a word or a dot.",
      "Geist for interface text, Geist Mono for machine values, tabular figures on every number.",
      "Compact, information-dense tables with a synced JSON pane as the signature interaction."
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "Crimson marks only the primary action and what is selected, current or focused, and it never decorates, never draws a data series and never signals status.",
        "section": "colors"
      },
      {
        "name": "The Engine Signal Rule",
        "body": "Green means healthy, amber means attention and red means failure, each always carried by a word, a dot or an icon alongside the colour, on a soft 11 to 12% wash of the same hue.",
        "section": "colors"
      },
      {
        "name": "The Slate Data Rule",
        "body": "Charts and meters draw in the slate family, and a status hue enters a meter only when the measured value itself is the warning.",
        "section": "colors"
      },
      {
        "name": "The Tabular Figures Rule",
        "body": "Tabular figures are set on the body, so every number that can change or be compared lines up in its column and counters and meters never jitter.",
        "section": "typography"
      },
      {
        "name": "The Machine Voice Rule",
        "body": "If the engine wrote it (an id, a key, a dtype, a path, a version) it is set in Geist Mono, and if a person reads it as a label it is set in Geist.",
        "section": "typography"
      },
      {
        "name": "The Sentence Case Rule",
        "body": "Labels and section heads are quiet 12px sentence case, and the system has no uppercase tracked labels.",
        "section": "typography"
      },
      {
        "name": "The Floating-Only Shadow Rule",
        "body": "A shadow means the layer floats above the frame and can be dismissed, so panels, cards and buttons never get one.",
        "section": "elevation"
      },
      {
        "name": "The No Atmosphere Rule",
        "body": "No gradients, no glass or backdrop blur and no glow, and focus is the only state that draws a ring.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep crimson to the primary action plus selected, current and focused states, one primary button per page head.",
      "**Do** put every status colour next to a word, a dot or an icon, on its own soft wash.",
      "**Do** set ids, keys, dtypes, versions and JSON in Geist Mono and give every number tabular figures.",
      "**Do** build depth from the ground, surface, raised and hover steps with 1px hairlines, and keep panels at 8px corners with a 42px header.",
      "**Do** let panels adapt to their own width with container queries, and collapse the page grid at the shared breakpoints.",
      "**Do** use the 2px crimson edge marker for any new selectable list, matching the points table and sidebar."
    ],
    "donts": [
      "**Don't** use gradients, glass or backdrop blur, or glow on any surface.",
      "**Don't** put shadows on panels, buttons or anything that sits in the page; shadows belong to menus, dialogs, toasts and the drawer.",
      "**Don't** use crimson for data series, decoration or status, and don't use green, amber or red for anything other than health, attention and failure.",
      "**Don't** add uppercase tracked labels or set text below 11px.",
      "**Don't** introduce a second accent hue or a light theme without a design decision recorded first."
    ]
  }
}